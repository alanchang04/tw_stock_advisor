# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Recommended: use one complete Neon/PostgreSQL connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Alternative for local PostgreSQL. These are used only when DATABASE_URL is
# empty. They match docker-compose.yml defaults.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=taiwan_stock
# DB_USER=stock_user
# DB_PASSWORD=stock_pass

# -----------------------------------------------------------------------------
# Market data (optional)
# -----------------------------------------------------------------------------
# Needed only for FinMind historical backfills.
# FINMIND_TOKEN=

# -----------------------------------------------------------------------------
# LLM analysis (optional)
# -----------------------------------------------------------------------------
# Use the key matching the selected model/provider.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_MODEL=gemini/gemini-2.5-flash
# LLM_DEBATE=0

# -----------------------------------------------------------------------------
# Telegram notifications and bot replies (optional)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Broker (optional; paper is the safe default)
# -----------------------------------------------------------------------------
BROKER=paper
# SHIOAJI_API_KEY=
# SHIOAJI_SECRET_KEY=
# SHIOAJI_SIMULATION=1

# -----------------------------------------------------------------------------
# Strategy and scheduling (optional defaults)
# -----------------------------------------------------------------------------
# TRADING_CAPITAL=1000000
# DAILY_FETCH_HOUR=18
# DAILY_ANALYSIS_HOUR=19

# -----------------------------------------------------------------------------
# Network tuning (optional defaults)
# -----------------------------------------------------------------------------
# SCRAPER_DELAY_SEC=2
# REQUEST_TIMEOUT_SEC=30
